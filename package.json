{
  "name": "app",
  "private": true,
  "devDependencies": {
    "esbuild": "^0.28.1"
  },
  "scripts": {
    "build": "esbuild app/javascript/frontend.js app/javascript/backend.js --bundle --sourcemap --format=esm --outdir=app/assets/builds --public-path=/assets",
    "build:css": "yarn build:css:frontend && yarn build:css:backend",
    "build:css:frontend": "tailwindcss -i ./app/assets/stylesheets/frontend.tailwind.css -o ./app/assets/builds/frontend.css --minify",
    "build:css:backend": "tailwindcss -i ./app/assets/stylesheets/backend.tailwind.css -o ./app/assets/builds/backend.css --minify"
  },
  "dependencies": {
    "@hotwired/stimulus": "^3.2.2",
    "@hotwired/turbo-rails": "^8.0.23",
    "@tailwindcss/cli": "^4.3.0",
    "tailwindcss": "^4.3.0"
  },
  "resolutions": {
    "source-map-js": "^1.2.2"
  }
}
