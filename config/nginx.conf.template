worker_processes auto;
pid /tmp/nginx.pid;

events {
  worker_connections 1024;
}

http {
  include /etc/nginx/mime.types;
  default_type application/octet-stream;

  access_log /dev/stdout;
  error_log /dev/stderr warn;

  sendfile on;
  tcp_nopush on;
  keepalive_timeout 65;
  client_max_body_size 25m;
  client_body_temp_path /tmp/nginx/client_body;
  proxy_temp_path /tmp/nginx/proxy;
  fastcgi_temp_path /tmp/nginx/fastcgi;
  uwsgi_temp_path /tmp/nginx/uwsgi;
  scgi_temp_path /tmp/nginx/scgi;

  map $http_upgrade $connection_upgrade {
    default upgrade;
    "" close;
  }

  map $request_uri $healthcheck {
    default 0;
    /up 1;
    ~^/up[?] 1;
  }

  map $host $allowed_app_host {
    default 0;
${APP_ALLOWED_HOST_MAP}
  }

  map $host $canonical_redirect {
    default 0;
${CANONICAL_REDIRECT_MAP}
  }

  map "$healthcheck:$allowed_app_host" $reject_app_host {
    default 0;
    "0:0" 1;
  }

  map "$healthcheck:$canonical_redirect" $perform_canonical_redirect {
    default 0;
    "0:1" 1;
  }

  map $healthcheck $staging_auth_realm {
    default Staging;
    1 off;
  }

  # try_files runs after auth_basic; invalid media must not return before auth.
  map $secure_link $media_root {
    default /tmp/nginx/denied-media;
    "1" /rails/storage;
  }

  gzip on;
  gzip_vary on;
  gzip_min_length 1024;
  gzip_proxied any;
  gzip_comp_level 5;
  gzip_types
    text/plain
    text/css
    text/javascript
    application/javascript
    application/json
    application/xml
    image/svg+xml
    font/woff2;

  server {
    listen 80;
    server_name _;

    root /rails/public;
    ${STAGING_NOINDEX_HEADER}
    ${STAGING_PRIVATE_CACHE_HEADER}
    ${STAGING_AUTH_CONFIG}

    if ($reject_app_host = 1) { return 421; }
    if ($perform_canonical_redirect = 1) { return 308 https://${CANONICAL_HOST}$request_uri; }

    location = /up {
      proxy_pass http://127.0.0.1:3000/up;
      proxy_set_header Host ${CANONICAL_HOST};
      proxy_set_header Content-Length "";
      proxy_pass_request_body off;
      proxy_method GET;
    }

    location ~ ^/media/(?<media_expires>\d+)/(?<media_signature>[-_A-Za-z0-9]+)/(?<media_path>.+)--[^/]+\.svg$ {
      secure_link $media_signature,$media_expires;
      secure_link_md5 "$secure_link_expires/${media_path}${MEDIA_PROXY_SECRET}";

      root $media_root;
      try_files /$media_path @media_unavailable;

      default_type image/svg+xml;
      expires ${STATIC_EXPIRES};
      ${STATIC_CACHE_CONTROL_HEADER}
      ${STAGING_NOINDEX_HEADER}
    }

    location ~ ^/media/(?<media_expires>\d+)/(?<media_signature>[-_A-Za-z0-9]+)/(?<media_path>.+)--[^/]+\.(?:jpg|jpeg)$ {
      secure_link $media_signature,$media_expires;
      secure_link_md5 "$secure_link_expires/${media_path}${MEDIA_PROXY_SECRET}";

      root $media_root;
      try_files /$media_path @media_unavailable;

      default_type image/jpeg;
      expires ${STATIC_EXPIRES};
      ${STATIC_CACHE_CONTROL_HEADER}
      ${STAGING_NOINDEX_HEADER}
    }

    location ~ ^/media/(?<media_expires>\d+)/(?<media_signature>[-_A-Za-z0-9]+)/(?<media_path>.+)--[^/]+\.png$ {
      secure_link $media_signature,$media_expires;
      secure_link_md5 "$secure_link_expires/${media_path}${MEDIA_PROXY_SECRET}";

      root $media_root;
      try_files /$media_path @media_unavailable;

      default_type image/png;
      expires ${STATIC_EXPIRES};
      ${STATIC_CACHE_CONTROL_HEADER}
      ${STAGING_NOINDEX_HEADER}
    }

    location ~ ^/media/(?<media_expires>\d+)/(?<media_signature>[-_A-Za-z0-9]+)/(?<media_path>.+)--[^/]+\.webp$ {
      secure_link $media_signature,$media_expires;
      secure_link_md5 "$secure_link_expires/${media_path}${MEDIA_PROXY_SECRET}";

      root $media_root;
      try_files /$media_path @media_unavailable;

      default_type image/webp;
      expires ${STATIC_EXPIRES};
      ${STATIC_CACHE_CONTROL_HEADER}
      ${STAGING_NOINDEX_HEADER}
    }

    location ~ ^/media/(?<media_expires>\d+)/(?<media_signature>[-_A-Za-z0-9]+)/(?<media_path>.+)--[^/]+$ {
      secure_link $media_signature,$media_expires;
      secure_link_md5 "$secure_link_expires/${media_path}${MEDIA_PROXY_SECRET}";

      root $media_root;
      try_files /$media_path @media_unavailable;

      expires ${STATIC_EXPIRES};
      ${STATIC_CACHE_CONTROL_HEADER}
      ${STAGING_NOINDEX_HEADER}
    }

    location ~ ^/media/(?<media_signature>[-_A-Za-z0-9]+)/(?<media_path>.+)/[^/]+\.svg$ {
      secure_link $media_signature;
      secure_link_md5 "${media_path}${MEDIA_PROXY_SECRET}";

      root $media_root;
      try_files /$media_path @media_unavailable;

      default_type image/svg+xml;
      expires ${STATIC_EXPIRES};
      ${STATIC_CACHE_CONTROL_HEADER}
      ${STAGING_NOINDEX_HEADER}
    }

    location ~ ^/media/(?<media_signature>[-_A-Za-z0-9]+)/(?<media_path>.+)/[^/]+\.(?:jpg|jpeg)$ {
      secure_link $media_signature;
      secure_link_md5 "${media_path}${MEDIA_PROXY_SECRET}";

      root $media_root;
      try_files /$media_path @media_unavailable;

      default_type image/jpeg;
      expires ${STATIC_EXPIRES};
      ${STATIC_CACHE_CONTROL_HEADER}
      ${STAGING_NOINDEX_HEADER}
    }

    location ~ ^/media/(?<media_signature>[-_A-Za-z0-9]+)/(?<media_path>.+)/[^/]+\.png$ {
      secure_link $media_signature;
      secure_link_md5 "${media_path}${MEDIA_PROXY_SECRET}";

      root $media_root;
      try_files /$media_path @media_unavailable;

      default_type image/png;
      expires ${STATIC_EXPIRES};
      ${STATIC_CACHE_CONTROL_HEADER}
      ${STAGING_NOINDEX_HEADER}
    }

    location ~ ^/media/(?<media_signature>[-_A-Za-z0-9]+)/(?<media_path>.+)/[^/]+\.webp$ {
      secure_link $media_signature;
      secure_link_md5 "${media_path}${MEDIA_PROXY_SECRET}";

      root $media_root;
      try_files /$media_path @media_unavailable;

      default_type image/webp;
      expires ${STATIC_EXPIRES};
      ${STATIC_CACHE_CONTROL_HEADER}
      ${STAGING_NOINDEX_HEADER}
    }

    location ~ ^/media/(?<media_signature>[-_A-Za-z0-9]+)/(?<media_path>.+)/[^/]+$ {
      secure_link $media_signature;
      secure_link_md5 "${media_path}${MEDIA_PROXY_SECRET}";

      root $media_root;
      try_files /$media_path @media_unavailable;

      expires ${STATIC_EXPIRES};
      ${STATIC_CACHE_CONTROL_HEADER}
      ${STAGING_NOINDEX_HEADER}
    }

    location ~ ^/assets/.+\.(css|js|woff2|svg|png|jpg|jpeg|webp)$ {
      expires ${STATIC_EXPIRES};
      ${STATIC_CACHE_CONTROL_HEADER}
      ${STAGING_NOINDEX_HEADER}
      try_files $uri @puma;
    }

    location / {
      try_files $uri @puma;
    }

    location @media_unavailable {
      if ($secure_link = "") { return 403; }
      if ($secure_link = "0") { return 403; }
      return 404;
    }

    location @puma {
      proxy_http_version 1.1;
      proxy_set_header Host $http_host;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
      proxy_set_header X-Forwarded-Host $host;
      proxy_set_header X-Forwarded-Port $server_port;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection $connection_upgrade;
      proxy_pass http://127.0.0.1:3000;
    }
  }
}
