<main id="main-content" class="page-main public-page legal-page" tabindex="-1">
      <section class="public-section section holding legal-section legal-section-youth" aria-labelledby="legal-title">
        <h1 id="legal-title"><%= @editable_page.title %></h1>
        <%= public_backend_link(
              label: "Bearbeiten",
              path: backend_pages_path(page_id: @editable_page.id),
              aria_label: "Jugendschutz bearbeiten"
            ) %>
        <div class="rich-copy legal-copy legal-copy-youth">
          <%= render "pages/legal/jugendschutz_#{I18n.locale}",
                     youth_copy_html: @editable_page.content_value("body_html") %>
        </div>
      </section>
    </main>
