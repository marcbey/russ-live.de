<% contact_page = @editable_page %>

<main id="main-content" class="page-main public-page contact-page" tabindex="-1">
  <section class="public-section section split" aria-labelledby="contact-title">
    <div class="contact-details">
      <h1 id="contact-title" class="contact-title"><%= contact_page.title %></h1>
      <div class="contact-quick-actions">
        <%= link_to "#{t("pages.contact.quick_actions.phone")}: +49 (0) 711 16 353 11", "tel:+497111635311", class: "public-button public-button-secondary" %>
        <%= mail_to "info@russ-live.de", "info@russ-live.de", class: "public-button public-button-secondary" %>
        <%= link_to t("pages.contact.quick_actions.timetable"), "https://www.vvs.de/verbindungen-und-mobilitaet/fahrplanauskunft", class: "public-button public-button-secondary" %>
      </div>
      <%= public_backend_link(
            label: "Bearbeiten",
            path: backend_pages_path(page_id: contact_page.id),
            aria_label: "Kontaktseite bearbeiten"
          ) %>

      <address class="public-contact-card rich-copy">
        <%= contact_page.content_value("body_html").html_safe %>
      </address>
    </div>
    <div class="contact-location-visual">
      <%= image_tag "russ_live/contact/kontakt-charlottenplatz.jpg",
                    alt: t("pages.contact.image_alt"),
                    class: "contact-location-image",
                    width: 1086,
                    height: 1448,
                    loading: "lazy",
                    decoding: "async" %>
    </div>
  </section>
</main>
